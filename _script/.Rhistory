axis2 = cat_dispersion,
axis3 = cat_salience,
y = total_shares_in_profile)) +
# Set the flow colors based on partisanship to track where the left/right goes
geom_alluvium(aes(fill = cat_partisanship), alpha = 0.7, width = 0.2) +
# Draw the categorical pillars
geom_stratum(width = 0.2, fill = "gray20", color = "white") +
# Label the pillars
geom_text(stat = "stratum", aes(label = after_stat(stratum)), color = "white", size = 3) +
scale_fill_manual(values = c("Left" = "steelblue", "Center" = "gray70", "Right" = "darkred")) +
scale_x_discrete(limits = c("Partisanship", "Dispersion", "Salience"), expand = c(0.15, 0.05)) +
labs(
title = "Structural Flow of Information: Ecosystem Typologies",
subtitle = "Ribbon width represents total absolute shares.",
y = "Total Shares",
fill = "Partisan Origin"
) +
theme_minimal() +
theme(
plot.title = element_text(face = "bold"),
panel.grid.major.x = element_blank(),
panel.grid.minor = element_blank()
)
