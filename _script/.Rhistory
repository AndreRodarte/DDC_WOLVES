# ==============================================================================
# STEP 7: Factional Diet Composition by Media Typology
# ==============================================================================
# Merge the typologies into the diet data
faction_diet_profiles <- media_diet_enriched %>%
left_join(domain_typologies %>% select(domain, media_profile), by = "domain") %>%
# Calculate what percentage of each faction's TOTAL diet goes to each profile
group_by(media_profile) %>%
summarise(
wolf_diet_allocation = sum(pct_of_wolf_diet, na.rm = TRUE),
nonwolf_diet_allocation = sum(pct_of_nonwolf_diet, na.rm = TRUE),
.groups = "drop"
) %>%
# Pivot long for side-by-side plotting
pivot_longer(
cols = c(wolf_diet_allocation, nonwolf_diet_allocation),
names_to = "faction",
values_to = "diet_percentage"
) %>%
mutate(
faction = if_else(faction == "wolf_diet_allocation", "Wolves", "Non-Wolves Right"),
# Filter out tiny niche noise (profiles that make up less than 2% of diets)
diet_percentage = if_else(diet_percentage < 2, NA_real_, diet_percentage)
) %>%
drop_na()
# Plot the comparative diet compositions
ggplot(faction_diet_profiles, aes(x = faction, y = diet_percentage, fill = media_profile)) +
geom_col(position = "fill", alpha = 0.9, color = "white") +
# Format Y-axis as percentages
scale_y_continuous(labels = scales::percent_format()) +
# Use a qualitative color palette suitable for distinct categories
scale_fill_brewer(palette = "Set3", name = "Media Typology Profile") +
labs(
title = "Media Diet Composition: Wolves vs. Non-Wolves Right",
subtitle = "Proportion of total factional attention allocated to distinct media typologies.",
x = "Political Faction",
y = "Proportion of Total Media Diet"
) +
theme_minimal() +
theme(
plot.title = element_text(face = "bold"),
legend.position = "right",
panel.grid.major.x = element_blank()
)
# ==============================================================================
# STEP 7 (REVISED): 3-Tier Factional Diet Composition
# (Left/Center vs. Non-Wolves Right vs. Wolves)
# ==============================================================================
# 1. Create the overarching 3-tier grouping for the entire parliament
parliament_nodes <- nodes_breakdown %>%
mutate(
faction_3tier = case_when(
is_wolf == 1 ~ "Wolves",
ideology_2021 > 0 & is_wolf == 0 ~ "Non-Wolves Right",
TRUE ~ "Left & Center" # Captures everyone else (ideology <= 0 or NA)
),
# Set the factor levels so the chart reads logically from Left to Far-Right
faction_3tier = factor(faction_3tier, levels = c("Left & Center", "Non-Wolves Right", "Wolves"))
)
# 2. Join the overarching groups to the cleanly filtered domain list
all_shares_clean <- domain_long_clean %>%
inner_join(parliament_nodes %>% select(author, faction_3tier), by = "author")
# 3. Calculate Total Media Output (Denominators) per group
group_budgets_3tier <- all_shares_clean %>%
group_by(faction_3tier) %>%
summarise(total_faction_shares = sum(share_count), .groups = "drop")
# 4. Calculate attention shares and merge with our typologies
faction_diet_profiles_3tier <- all_shares_clean %>%
group_by(faction_3tier, domain) %>%
summarise(domain_faction_shares = sum(share_count), .groups = "drop") %>%
# Bring in the total budgets to calculate percentages
inner_join(group_budgets_3tier, by = "faction_3tier") %>%
mutate(pct_of_diet = (domain_faction_shares / total_faction_shares) * 100) %>%
# Join the structural typologies we created in the previous step
left_join(domain_typologies %>% select(domain, media_profile), by = "domain") %>%
filter(!is.na(media_profile)) %>% # Drop any extreme low-N noise that missed the typology cut
# Aggregate the percentages by profile and faction
group_by(faction_3tier, media_profile) %>%
summarise(total_diet_percentage = sum(pct_of_diet), .groups = "drop") %>%
# Filter out structural noise (profiles making up less than 2% of a group's diet)
mutate(total_diet_percentage = if_else(total_diet_percentage < 2, NA_real_, total_diet_percentage)) %>%
drop_na()
# 5. Plot the 3-column progression
ggplot(faction_diet_profiles_3tier, aes(x = faction_3tier, y = total_diet_percentage, fill = media_profile)) +
geom_col(position = "fill", alpha = 0.9, color = "white") +
# Format Y-axis as percentages
scale_y_continuous(labels = scales::percent_format()) +
# Use a distinct categorical palette
scale_fill_brewer(palette = "Set3", name = "Media Typology Profile") +
labs(
title = "The Architecture of Polarization: Media Diet by Parliamentary Bloc",
subtitle = "Tracks the allocation of attention from the mainstream baseline to the populist fringe.",
x = "Parliamentary Faction",
y = "Proportion of Total Media Diet"
) +
theme_minimal() +
theme(
plot.title = element_text(face = "bold"),
legend.position = "right",
panel.grid.major.x = element_blank()
)
# ==============================================================================
# STEP 8 (REVISED): Connective Faction Test via Partisan-Exclusive Filtering
# ==============================================================================
# 1. Identify the domains that represent the partisan, exclusive network
partisan_exclusive_domains <- domain_typologies %>%
filter(cat_dispersion == "Exclusive" & cat_partisanship != "Center") %>%
pull(domain)
# 2. Reconstruct a clean matrix using ONLY these radical/partisan domains
filtered_matrix_df <- domain_long_clean %>%
filter(domain %in% partisan_exclusive_domains) %>%
pivot_wider(names_from = domain, values_from = share_count, values_fill = 0) %>%
column_to_rownames("author")
# Convert to matrix form
mat_filtered <- as.matrix(filtered_matrix_df)
# Check if any authors were dropped entirely because they ONLY shared mainstream news
# We must keep track of who is actually in this sub-network
active_authors <- rownames(mat_filtered)
# 3. Calculate Cosine Similarity to normalize for posting volume
mat_norm_filtered <- mat_filtered / sqrt(rowSums(mat_filtered^2))
# Replace NaNs with 0 (occurs if an author's row sum is 0 after filtering)
mat_norm_filtered[is.na(mat_norm_filtered)] <- 0
sim_matrix_filtered <- mat_norm_filtered %*% t(mat_norm_filtered)
# 4. Network Construction
# Remove self-loops
diag(sim_matrix_filtered) <- 0
# Apply a stricter threshold since we are dealing with hyper-specific partisan ties
threshold_partisan <- 0.15
sim_matrix_filtered[sim_matrix_filtered < threshold_partisan] <- 0
# Build the undirected, weighted igraph object
g_partisan <- graph_from_adjacency_matrix(
sim_matrix_filtered,
mode = "undirected",
weighted = TRUE,
diag = FALSE
)
# Optional: Remove isolated nodes (politicians with no ties in this specific sub-network)
g_partisan <- delete_vertices(g_partisan, degree(g_partisan) == 0)
# 5. Unsupervised Community Detection (Louvain)
set.seed(42)
louvain_comm_partisan <- cluster_louvain(g_partisan)
# 6. Extract the emergent communities
community_df_partisan <- data.frame(
author = V(g_partisan)$name,
emergent_community = as.factor(louvain_comm_partisan$membership)
)
# 7. Validate against the theoretical "Wolf" faction
validation_df_partisan <- community_df_partisan %>%
inner_join(
nodes_breakdown %>% select(author, is_wolf, party, ideology_2021),
by = "author"
)
# Generate the cross-tabulation table
cross_tab_partisan <- table(
Emergent_Community = validation_df_partisan$emergent_community,
Is_Wolf = validation_df_partisan$is_wolf
)
print("Results of Connective Faction Clustering (Exclusive Partisan Media Only):")
print(cross_tab_partisan)
# ==============================================================================
# STEP 10 (REVISED): Multi-Modal Classification of Election Denialism
# ==============================================================================
# 1. Prepare the post-level dataset using the composite metric
post_level_analysis_robust <- df_fb_election %>%
# Keep only posts with a linked domain, valid Q2, and valid PEC135 vote
filter(!is.na(domain) & domain != "" & !is.na(Q2) & !is.na(PEC135)) %>%
# Join structural typologies
inner_join(
domain_typologies %>% select(domain, media_profile, cat_partisanship, cat_dispersion),
by = "domain"
) %>%
# Create a clean week variable for temporal tracking
mutate(
post_week = floor_date(timestamp, "week"),
# The Composite Variable: Text flags skepticism AND Author voted for printed ballot
true_denialism = if_else(Q2 == 1 & PEC135 == 1, 1, 0)
)
# 2. Descriptive Probability: Media types predicting true denialism
denialism_by_profile <- post_level_analysis_robust %>%
group_by(media_profile) %>%
summarise(
total_posts_with_link = n(),
true_denial_posts = sum(true_denialism, na.rm = TRUE),
pct_true_denial = (true_denial_posts / total_posts_with_link) * 100,
.groups = "drop"
) %>%
# Filter out low-N noise profiles
filter(total_posts_with_link >= 50) %>%
arrange(desc(pct_true_denial))
print("Probability of Election Denialism (Q2=1 & PEC135=1) by Media Typology:")
print(denialism_by_profile)
# 3. Visualization 1: The Discursive Vector (Corrected)
ggplot(denialism_by_profile, aes(x = reorder(media_profile, pct_true_denial), y = pct_true_denial)) +
geom_col(aes(fill = grepl("Right \\| Exclusive", media_profile)), alpha = 0.9) +
coord_flip() +
scale_fill_manual(values = c("TRUE" = "darkred", "FALSE" = "gray70")) +
scale_y_continuous(labels = scales::percent_format(scale = 1)) +
labs(
title = "Alternative Media as Vectors of True Election Denialism",
subtitle = "Percentage of posts flagged for denialism (Textual Skepticism + PEC135 Support).",
x = NULL,
y = "Probability of Post Containing True Denialism",
fill = "Far-Right Alternative Ecosystem"
) +
theme_minimal() +
theme(
plot.title = element_text(face = "bold"),
legend.position = "none"
)
# ==============================================================================
# STEP 11 (REVISED): Temporal Analysis of True Denialism
# ==============================================================================
# Aggregate the volume of true denialist posts over time
temporal_denialism <- post_level_analysis_robust %>%
filter(true_denialism == 1) %>%
mutate(
broad_media_type = case_when(
cat_partisanship == "Right" & cat_dispersion == "Exclusive" ~ "Far-Right Alternative",
cat_partisanship == "Center" ~ "Mainstream/Centrist",
TRUE ~ "Other"
)
) %>%
group_by(post_week, broad_media_type) %>%
summarise(denialist_volume = n(), .groups = "drop")
# Visualization 2: The Timeline
ggplot(temporal_denialism, aes(x = post_week, y = denialist_volume, color = broad_media_type)) +
geom_line(size = 1.2) +
geom_point(alpha = 0.6) +
scale_color_manual(values = c("Far-Right Alternative" = "darkred", "Mainstream/Centrist" = "gray60", "Other" = "steelblue")) +
labs(
title = "The Timeline of Discursive Radicalization",
subtitle = "Weekly volume of denialist posts by PEC135 supporters, categorized by media link.",
x = "Timeline",
y = "Volume of True Denialist Posts",
color = "Linked Media Ecosystem"
) +
theme_minimal() +
theme(
plot.title = element_text(face = "bold"),
legend.position = "bottom"
)
